haadi-tunnel.online {
	# Reverse proxy WebSocket endpoint (must come first)
	handle /ws {
		reverse_proxy server:9002 {
			# Enable WebSocket support
			header_up Upgrade {http.upgrade}
			header_up Connection {http.connection}
		}
	}

	# Reverse proxy REST API endpoint
	handle /chatter-count {
		reverse_proxy server:9002
	}

	# Serve the web app (static files)
	root * /web/dist
	handle {
		try_files {path} /index.html
		file_server
	}
}

